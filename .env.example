# Copiar este archivo a ".env" (ya está en .gitignore) y completar los
# valores para desarrollo local. En producción (Render) estas mismas
# variables se configuran directo en el panel del hosting, no acá.

# --- Django ---
# En local: True. En producción: False (o directamente no definir esta
# variable, ya que False es el default).
DJANGO_DEBUG=True

# Obligatoria si DJANGO_DEBUG=False. Generarla con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Dominios separados por coma (ej: lmve.cl,www.lmve.cl). Vacío está bien
# en local con DEBUG=True.
DJANGO_ALLOWED_HOSTS=

# Ruta del panel de administración (sin la barra inicial, con la final).
# Si se deja vacía, queda en "admin/".
DJANGO_ADMIN_URL=

# --- Base de datos ---
# Si no se define, se usa el db.sqlite3 local de siempre.
DATABASE_URL=

# --- Correo del formulario de Contacto (Gmail + contraseña de aplicación) ---
# Sin estas dos, los correos solo se imprimen en la terminal (no se envían).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
CONTACTO_DESTINATARIO=

# --- Monitoreo de errores (opcional) ---
# Sin esta variable, Sentry simplemente no se activa.
SENTRY_DSN=
